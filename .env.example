# Flag para alternar entre dados mockados e live scraping
# Em produção inicial na Vercel, mantenha USE_MOCK=true para garantir 100% de disponibilidade
NEXT_PUBLIC_USE_MOCK=true

# URLs dos Portais Oficiais de Valinhos
NEXT_PUBLIC_CAMARA_URL=https://www.camaravalinhos.sp.gov.br
NEXT_PUBLIC_TRANSPARENCIA_URL=https://transparencia-camaravalinhos.smarapd.com.br
NEXT_PUBLIC_TCE_URL=https://www4.tce.sp.gov.br

# Timeout do scraper em milissegundos
SCRAPER_TIMEOUT_MS=15000

# Nome da Aplicação
NEXT_PUBLIC_APP_NAME="Transparência Valinhos"
